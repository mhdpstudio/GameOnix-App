{
  "name": "gameonix-app",
  "private": true,
  "version": "1.1.63",
  "author": {
    "name": "Mahmoud Pro"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "description": "GameOnix desktop app with integrated torrent downloads",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "start": "npm run dev",
    "dist": "npm run build && electron-builder --win dir",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "cors": "^2.8.6",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.gameonix.desktop",
    "productName": "GameOnix",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "build/gameonix.ico",
      "package.json"
    ],
    "afterPack": "electron/after-pack.cjs",
    "extraResources": [
      {
        "from": "build/gameonix.ico",
        "to": "gameonix.ico"
      },
      {
        "from": "build/gameonix-icon.png",
        "to": "gameonix-icon.png"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "build/gameonix.ico",
      "target": "dir"
    }
  }
}
